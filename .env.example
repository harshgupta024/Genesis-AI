# Genesis Data Pipeline Environment Variables
# Do not commit the actual .env file to version control.

# GBIF API Credentials (for Biodiversity data)
GBIF_USERNAME=your_username
GBIF_PASSWORD=your_password
GBIF_EMAIL=your_email@example.com

# NASA Earthdata Credentials (for Earth Observation data)
NASA_EARTHDATA_USERNAME=your_username
NASA_EARTHDATA_PASSWORD=your_password
